# Copier ce fichier en ".env" (jamais versionné dans Git ni partagé) et remplir les vraies valeurs

PORT=4000

# --- Connexion PostgreSQL ---
# Option A (recommandée en production, ex: Render, Railway, Supabase, Neon) :
# une seule URL de connexion complète.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/fastira

# Option B (développement local) : paramètres séparés, utilisés seulement
# si DATABASE_URL n'est pas définie.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=fastira

# Mettre à "false" seulement en local si votre PostgreSQL local n'a pas SSL activé.
# En production (DATABASE_URL), le SSL est activé automatiquement.
PGSSL=false

# Clé secrète utilisée pour signer les tokens de connexion (JWT)
# Générer une valeur longue et aléatoire, par ex avec : openssl rand -hex 32
JWT_SECRET=remplacer_par_une_longue_chaine_aleatoire

# Durée de validité d'une session de connexion
JWT_EXPIRES_IN=7d

# URL du frontend autorisée à appeler l'API (protection CORS)
# En production, mettre l'URL réelle du site, ex: https://fastira.mg
FRONTEND_URL=http://localhost:5500

# Email de contact vers lequel transférer les messages du formulaire public
# (utilisé par contactController.js si l'envoi d'email est activé)
EMAIL_CONTACT_DESTINATAIRE=contact@fastira.mg
